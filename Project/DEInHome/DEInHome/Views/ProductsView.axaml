<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DEInHome.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Page"
             x:Class="DEInHome.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">
  <Grid RowDefinitions="Auto, Auto, *">
	  <Grid Grid.Row="0"
            Grid.ColumnDefinitions="auto, *, auto"
            Margin="10">
		  <Button Grid.Column="0"
                  Content="Выход"
                  Command="{Binding NavigateBackCommand}"/>
          <TextBlock Grid.Column="2"
                     Text="{Binding UserFullName}"/>
      </Grid>

      <Grid Grid.Row="1" Grid.ColumnDefinitions="auto, *, auto">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="10 0 0 0"
                        IsVisible="{Binding IsVisibleManager}">
		        <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                        PlaceholderText="Поиск..."
                        Width="200"/>

                <ComboBox ItemsSource="{Binding FilterParametrs}"
                        SelectedItem="{Binding SelectedFilterParameters}"
                        Width="150"/>
          
                <ComboBox ItemsSource="{Binding SortedParameters}"
                        SelectedItem="{Binding SelectedSortedParameters}"
                        Width="150"/>
            </StackPanel>

            <Button Grid.Column="2" Content="Добавить" 
                    Command="{Binding AddProductCommand}"
                    IsVisible="{Binding IsVisibleAdmin}"/>
        </Grid>

      <ScrollViewer Grid.Row="2">
        <ItemsControl ItemsSource="{Binding Products}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border  Width="600"
                             Height="200" 
                             CornerRadius="8"
                             BoxShadow="4 4 8 #40000000"
                             Background="LightBlue"
                             Margin="10"
                             Padding="5">
						<Grid ColumnDefinitions="2.5* 6* 1.5*" RowDefinitions="8.5* 1.5*">
							<Image Grid.Column="0"
                                    Source="{Binding ProductImage}"/>

                            <StackPanel Grid.Column="1" Spacing="10" Margin="10">
                                <TextBlock Text="{Binding NameCard}"/>
                                <TextBlock Text="{Binding Manufacture.Name, StringFormat='Произоводитель: {0}'}"/>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0}'}"
                                           Foreground="Red"
                                           TextDecorations="Strikethrough"
                                           IsVisible="{Binding HasDiscount}"/>
                                 <TextBlock Text="{Binding CaclPrice, StringFormat='Итоговая цена: {0}'}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Discount, StringFormat=' {0}%'}"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
								<Button Content="Редактировать" Command="{Binding #Page.DataContext.EditProductCommand}" CommandParameter="{Binding}"/>
								<Button Content="Удалить" Command="{Binding #Page.DataContext.RemoveProductCommand}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
  </Grid>
</UserControl>
