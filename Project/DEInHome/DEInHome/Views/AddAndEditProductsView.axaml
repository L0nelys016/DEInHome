<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DEInHome.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DEInHome.Views.AddAndEditProductsView"
             x:DataType="vm:AddAndEditProductsViewModel">
  
     <Grid RowDefinitions="auto, *">
		<StackPanel Grid.Row="0" 
              Orientation="Horizontal"
              Spacing="10">
            <Button Content="Назад"
                    Command="{Binding NavigateBackCommand}"
                    Background="#7FFF00"/>
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Background="#7FFF00"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
			<Grid ColumnDefinitions="auto, auto">
				<StackPanel Grid.Column="0"
                            Spacing="30">
                    <Image Source="{Binding SelectedProduct.ProductImage}"
                           Width="300"
                           Height="200"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           Margin="28 0 0 0"/>

                    <Button Content="Загрузить..."
                            Command="{Binding SelectedImageCommand}"
                            Background="#7FFF00"
                            Margin="28 0 0 0"/>

                    <TextBox PlaceholderText="Описание"
                             Text="{Binding SelectedProduct.Description, Mode=TwoWay}"
                             TextWrapping="Wrap"
                             MaxWidth="250"
                             Width="250"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Spacing="10">
					<TextBlock Text="{Binding SelectedProduct.Id}"
                               IsVisible="{Binding IsEditMode}"/>
                    
                    <TextBox Text="{Binding SelectedProduct.Article, Mode=TwoWay}"/>

                    <ComboBox ItemsSource="{Binding ProductTypes}"
                              SelectedItem="{Binding SelectedProductType}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Units}"
                              SelectedItem="{Binding SelectedUnit}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Manufactures}"
                              SelectedItem="{Binding SelectedManufacture}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding ProductCategories}"
                              SelectedItem="{Binding SelectedProductCategory}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox PlaceholderText="Цена"
                             Text="{Binding SelectedProduct.Price, Mode=TwoWay}"/>
                    <TextBox PlaceholderText="Количество не складе"
                             Text="{Binding SelectedProduct.Quantity, Mode=TwoWay}"/>
                    <TextBox PlaceholderText="Скидка"
                             Text="{Binding SelectedProduct.Discount, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
