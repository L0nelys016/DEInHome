<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DEInHome.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DEInHome.Views.AuthView"
             x:DataType="vm:AuthViewModel">
    <Border Width="300"
            Height="200"
            CornerRadius="8"
            BoxShadow="4 4 8 #40000000"
            Background="LightBlue">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
            <TextBlock Text="Авторизация"
                       HorizontalAlignment="Center"/>
            <TextBox Text="{Binding LoginValue, Mode=TwoWay}"
                     PlaceholderText="Login"
                     Width="200"/>
            <TextBox Text="{Binding PasswordValue, Mode=TwoWay}"
                     PlaceholderText="Password"
                     Width="200"
                     PasswordChar="*"/>
            <StackPanel Orientation="Horizontal" 
                        Spacing="10"
                        HorizontalAlignment="Center">
                <Button Content="Вход" Command="{Binding AuthCommand}"/>
                <Button Content="Войти как гость" Command="{Binding LogInGuestCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
